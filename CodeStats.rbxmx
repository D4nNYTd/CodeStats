					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local windowController = {}

function windowController.create(template: Instance, pluginObject: Plugin): DockWidgetPluginGui
	local widget: DockWidgetPluginGui = pluginObject:CreateDockWidgetPluginGui(
		"codeStats",
		DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, true, 360, 620, 240, 580)
	)
	widget.Title = "CodeStats"
	for _, child in ipairs(template:GetChildren()) do
		child:Clone().Parent = widget
	end
	local root = widget:FindFirstChild("root", true)
	if root and root:IsA("Frame") then
		root.AnchorPoint = Vector2.new(0.5, 0.5)
		root.Position = UDim2.fromScale(0.5, 0.5)
		root.Size = UDim2.fromScale(1, 1)
	end
	return widget
end

return windowController
]]></ProtectedString>
					<string name="ScriptGuid">{2FBE0DCD-6B1E-46A5-A629-C75ED2DCD608}</string>
