			</Item>
			<Item class="ModuleScript" referent="RBXAF594FED2D4849F6AE4F7C98A6765EDB">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local tweenService = game:GetService("TweenService")

local animations = {}

local hoverInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local progressInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function animations.hover(button: GuiButton, normalColor: Color3, hoverColor: Color3): {RBXScriptConnection}
	local onEnter = button.MouseEnter:Connect(function()
		tweenService:Create(button, hoverInfo, { BackgroundColor3 = hoverColor }):Play()
	end)
	local onLeave = button.MouseLeave:Connect(function()
		tweenService:Create(button, hoverInfo, { BackgroundColor3 = normalColor }):Play()
	end)
	return { onEnter, onLeave }
end

local progressTween: Tween? = nil

function animations.progress(fill: GuiObject, scale: number)
	if progressTween then
		progressTween:Cancel()
	end
	local tween = tweenService:Create(fill, progressInfo, { Size = UDim2.new(scale, 0, 1, 0) })
	progressTween = tween
	tween:Play()
end

return animations
]]></ProtectedString>
