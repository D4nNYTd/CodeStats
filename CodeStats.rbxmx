--hi!
local mainUi = require(script.Parent.ui.mainUi)
local windowController = require(script.Parent.ui.windowController)
local template = script.Parent.codeStatsUi

local toolbar = plugin:CreateToolbar("CodeStats")
local toggleButton = toolbar:CreateButton(
	"CodeStats",
	"Open the CodeStats",
	"rbxassetid://88871649202000",
	"CodeStats"
)

local widget = windowController.create(template, plugin)
mainUi.bind(widget)

toggleButton.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)
widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	toggleButton:SetActive(widget.Enabled)

end)
