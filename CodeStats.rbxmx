				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local formatter = require(script.Parent.Parent.utils.formatter)
local scanner = require(script.Parent.Parent.utils.scanner)

local explorerList = {}

local classIcons = {
	Script = "rbxassetid://129625772881841",
	LocalScript = "rbxassetid://82571168239936",
	ModuleScript = "rbxassetid://92776861835929",
}

local classColors = {
	Script = Color3.fromRGB(88, 166, 255),
	LocalScript = Color3.fromRGB(120, 200, 120),
	ModuleScript = Color3.fromRGB(196, 140, 255),
}

export type Theme = {
	accent: Color3,
	panel: Color3,
	text: Color3,
	error: Color3,
	muted: Color3,
}

local function findIn(parent: Instance, name: string): any
	local found = parent:FindFirstChild(name, true)
	assert(found, "codeStats row element missing: " .. name)
	return found
end

function explorerList.new(list: ScrollingFrame, emptyState: GuiObject, rowTemplate: TextButton, theme: Theme, onSelect: (number) -> ())
	local rowConnections: {RBXScriptConnection} = {}

	local function disconnect()
		for _, connection in ipairs(rowConnections) do
			connection:Disconnect()
		end
		table.clear(rowConnections)
	end

	local function highlight(selectedIndex: number?)
		for _, child in ipairs(list:GetChildren()) do
			if child.Name == "scriptRow" and child:IsA("GuiObject") then
				child.BackgroundColor3 = if child.LayoutOrder == selectedIndex then theme.accent else theme.panel
			end
		end
	end

	local function render(results: {scanner.ScriptResult}, selectedIndex: number?)
		disconnect()
		for _, child in ipairs(list:GetChildren()) do
			if child.Name == "scriptRow" then
				child:Destroy()
			end
		end
		emptyState.Visible = #results == 0
		for index, result in ipairs(results) do
			local row = rowTemplate:Clone() :: TextButton
			row.Name = "scriptRow"
			row.Visible = true
			row.LayoutOrder = index
			row.BackgroundColor3 = if index == selectedIndex then theme.accent else theme.panel
			local indicator = findIn(row, "classIndicator")
			local icon = indicator:FindFirstChild("classIcon")
			local iconId = classIcons[result.className] or ""
			if icon and icon:IsA("ImageLabel") and iconId ~= "" then
				icon.Image = iconId
				icon.Visible = true
			else
				indicator.BackgroundColor3 = classColors[result.className] or theme.muted
				if icon and icon:IsA("ImageLabel") then
					icon.Visible = false
				end
			end
			findIn(row, "scriptName").Text = result.name
			findIn(row, "scriptClass").Text = result.className
			local lines = findIn(row, "scriptLines")
			lines.Text = if result.error then "Error" else formatter.number(result.totalLines)
			lines.TextColor3 = if result.error then theme.error else theme.text
			row.Parent = list
			local connection = row.Activated:Connect(function()
				onSelect(index)
			end)
			table.insert(rowConnections, connection)
		end
	end

	return { render = render, highlight = highlight, disconnect = disconnect }
end

return explorerList
]]></ProtectedString>
					<string name="ScriptGuid">{F3D09F5D-E3ED-412B-B5F5-907AD97C6358}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">explorerList</string>
