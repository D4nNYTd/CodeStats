					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")

local exportManager = {}

function exportManager.buildPayload(scanMode: string, summary: any, results: {any}): {[string]: any}
	local scripts = {}
	for _, result in ipairs(results) do
		table.insert(scripts, {
			name = result.name,
			className = result.className,
			path = result.path,
			totalLines = result.totalLines,
			codeLines = result.codeLines,
			commentLines = result.commentLines,
			blankLines = result.blankLines,
			error = result.error,
		})
	end
	return {
		scanMode = scanMode,
		exportedAt = os.date("!%Y-%m-%dT%H:%M:%SZ"),
		overall = {
			totalLines = summary.totalLines,
			codeLines = summary.codeLines,
			commentLines = summary.commentLines,
			blankLines = summary.blankLines,
		},
		totalScannedScripts = summary.totalScanned,
		successfullyScanned = summary.successfulScans,
		failedScripts = summary.failedScans,
		scripts = scripts,
	}
end

function exportManager.toJson(payload: {[string]: any}): (string?, string?)
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
	if not ok then
		return nil, tostring(encoded)
	end
	return encoded, nil
end

return exportManager
]]></ProtectedString>
