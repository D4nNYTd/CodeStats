			<Item class="ModuleScript" referent="RBXF20760F11B8B4B2DA1EB1051AE5492E2">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local counter = require(script.Parent.Parent.utils.counter)
local exportManager = require(script.Parent.Parent.utils.exportManager)
local formatter = require(script.Parent.Parent.utils.formatter)
local scanner = require(script.Parent.Parent.utils.scanner)
local selectionManager = require(script.Parent.Parent.utils.selectionManager)
local animations = require(script.Parent.animations)
local explorerList = require(script.Parent.explorerList)
local detailsPanel = require(script.Parent.detailsPanel)

local mainUi = {}

local scanModes = {
	{ id = "entireGame" },
	{ id = "selectedFolder" },
	{ id = "selectedScripts" },
}

local accentColor = Color3.fromRGB(0, 122, 204)
local buttonColor = Color3.fromRGB(62, 62, 66)
local panelColor = Color3.fromRGB(45, 45, 48)
local textColor = Color3.fromRGB(230, 230, 230)
local errorColor = Color3.fromRGB(232, 92, 92)
local muted = Color3.fromRGB(150, 150, 155)

local function find(parent: Instance, name: string): any
	local found = parent:FindFirstChild(name, true)
	assert(found, "codeStats UI element missing: " .. name)
	return found
end

function mainUi.bind(widget: DockWidgetPluginGui)
	local state = {
		mode = "entireGame",
		results = {} :: {scanner.ScriptResult},
		summary = counter.summarize({}),
		selectedIndex = nil :: number?,
		scanning = false,
		cancelRequested = false,
	}
	local connections: {RBXScriptConnection} = {}

	local refreshButton: TextButton = find(widget, "refreshButton")
	local exportButton: TextButton = find(widget, "exportButton")
	for _, c in ipairs(animations.hover(refreshButton, buttonColor, Color3.fromRGB(78, 78, 82))) do table.insert(connections, c) end
	for _, c in ipairs(animations.hover(exportButton, buttonColor, Color3.fromRGB(78, 78, 82))) do table.insert(connections, c) end
	local modeButtons: {[string]: TextButton} = {}
	for _, mode in ipairs(scanModes) do
		modeButtons[mode.id] = find(widget, mode.id .. "Mode")
	end
	local valueLabels = {
		totalLines = find(find(widget, "totalLinesCard"), "value"),
		codeLines = find(find(widget, "codeLinesCard"), "value"),
		commentLines = find(find(widget, "commentLinesCard"), "value"),
		blankLines = find(find(widget, "blankLinesCard"), "value"),
	}
	local list = find(widget, "scriptExplorer")
	local emptyState = find(widget, "emptyState")
	local rowTemplate = find(widget, "scriptRowTemplate")
	local exportPanel = find(widget, "exportPanel")
	local detailsEmpty = find(widget, "detailsEmpty")
	local detailName = find(widget, "detailName")
	local detailRows = {}
	for _, id in ipairs({ "total", "code", "comment", "blank" }) do
		detailRows[id] = { left = find(widget, id .. "Title"), right = find(widget, id .. "Value") }
	end
	local statusText = find(widget, "statusText")
	local progressFill = find(widget, "progressFill")
	local processedText = find(widget, "processedText")
	local lastScanText = find(widget, "lastScanText")
	local errorText = find(widget, "errorText")

	local function setProgress(processed: number, total: number)
		animations.progress(progressFill, if total > 0 then processed / total else 0)
		processedText.Text = `Processed {processed} / {total} scripts`
	end

	local function updateStats()
		local summary = state.summary
		valueLabels.totalLines.Text = formatter.number(summary.totalLines)
		valueLabels.codeLines.Text = formatter.number(summary.codeLines)
		valueLabels.commentLines.Text = formatter.number(summary.commentLines)
		valueLabels.blankLines.Text = formatter.number(summary.blankLines)
	end

	local function updateModeButtons()
		for id, button in pairs(modeButtons) do
			button.BackgroundColor3 = if id == state.mode then accentColor else buttonColor
		end
	end

	local selectScript: (number) -> ()

	local explorer = explorerList.new(list, emptyState, rowTemplate, {
		accent = accentColor,
		panel = panelColor,
		text = textColor,
		error = errorColor,
		muted = muted,
	}, function(index: number)
		selectScript(index)
	end)
	local function fitExplorer()
		local root = find(widget, "root")
		local explorerSection = find(widget, "explorerSection")
		local rootLayout = root:FindFirstChildWhichIsA("UIListLayout")
		local padding = root:FindFirstChildWhichIsA("UIPadding")
		local gap = if rootLayout then rootLayout.Padding.Offset else 0
		local used, count = 0, 0
		for _, child in ipairs(root:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible then
				count += 1
				if child ~= explorerSection then
					used += child.Size.Y.Offset
				end
			end
		end
		local vertical = if padding then padding.PaddingTop.Offset + padding.PaddingBottom.Offset else 0
		local available = root.AbsoluteSize.Y - vertical - used - gap * math.max(count - 1, 0)
		explorerSection.Size = UDim2.new(explorerSection.Size.X.Scale, explorerSection.Size.X.Offset, 0, math.max(available, 40))
	end
	local detailsView = detailsPanel.new(find(widget, "selectedDetails"), detailsEmpty, detailName, detailRows)
	local details = {
		render = function(result: scanner.ScriptResult?)
			detailsView.render(result, fitExplorer)
		end,
	}

	selectScript = function(index: number)
		if state.selectedIndex == index then
			state.selectedIndex = nil
			explorer.highlight(nil)
			details.render(nil)
			return
		end
		state.selectedIndex = index
		explorer.highlight(index)
		details.render(state.results[index])
	end

	local function setStatus(text: string)
		statusText.Text = text
	end

	local function setError(text: string)
		errorText.Text = text
	end

	local exportChunkSize = 190000
	local function splitUtf8(text: string, size: number): {string}
		local chunks = {}
		local start = 1
		while start <= #text do
			local stop = math.min(start + size - 1, #text)
			while stop > start and stop < #text do
				local nextByte = string.byte(text, stop + 1)
				if nextByte < 0x80 or nextByte >= 0xC0 then
					break
				end
				stop -= 1
			end
			table.insert(chunks, string.sub(text, start, stop))
			start = stop + 1
		end
		return chunks
	end
	local exportTemplate = find(widget, "exportText")
	local function exportResults()
		if exportPanel.Visible then
			exportPanel.Visible = false
			return
		end
		if #state.results == 0 then
			setStatus("Nothing to export. Run a scan first.")
			return
		end
		local json, encodeError = exportManager.toJson(exportManager.buildPayload(state.mode, state.summary, state.results))
		if not json then
			setStatus("Export failed")
			setError(encodeError or "JSON encoding failed")
			return
		end
		for _, child in ipairs(exportPanel:GetChildren()) do
			if child.Name == "exportChunk" then
				child:Destroy()
			end
		end
		local chunks = splitUtf8(json, exportChunkSize)
		local parts = #chunks
		for index, text in ipairs(chunks) do
			local chunk = exportTemplate:Clone()
			chunk.Name = "exportChunk"
			chunk.Text = text
			chunk.LayoutOrder = index
			chunk.Visible = true
			chunk.Parent = exportPanel
		end
		exportPanel.Visible = true
		setError("")
		if parts == 1 then
			setStatus("JSON shown below: click it, press Ctrl+A, then Ctrl+C.")
		else
			setStatus(`JSON split into {parts} parts: copy them in order and join them.`)
		end
	end

	local function runScan(mode: string)
		if state.scanning then
			setStatus("Wait for the scan to finish or press Cancel.")
			return
		end
		state.mode = mode
		updateModeButtons()
		local scripts, problem = selectionManager.resolve(mode)
		if problem then
			setStatus(problem)
			return
		end
		state.scanning = true
		state.cancelRequested = false
		refreshButton.Text = "Cancel"
		exportPanel.Visible = false
		setError("")
		setStatus("Scanning...")
		setProgress(0, #scripts)
		local ok, results, cancelled = pcall(scanner.scanScripts, scripts, function(index: number, total: number)
			if index % 10 == 0 or index == total then
				setProgress(index, total)
			end
		end, function(): boolean
			return state.cancelRequested
		end)
		state.scanning = false
		refreshButton.Text = "Refresh"
		if not ok then
			setStatus("Scan failed")
			setError(tostring(results))
			return
		end
		state.results = results
		state.summary = counter.summarize(results)
		state.selectedIndex = nil
		lastScanText.Text = `Last scan: {os.date("%H:%M:%S")} · {#results} scripts`
		updateStats()
		explorer.render(state.results, state.selectedIndex)
		details.render(nil)
		setProgress(#results, #scripts)
		if cancelled then
			setStatus("Scan cancelled")
		elseif #scripts == 0 then
			setStatus("No supported scripts found")
		elseif state.summary.failedScans > 0 then
			setStatus("Scan finished with errors")
		else
			setStatus("Scan complete")
		end
		processedText.Text = `Read {state.summary.successfulScans} / {#scripts} scripts · Failed {state.summary.failedScans}`
		if state.summary.failedScans > 0 then
			setError(`{state.summary.failedScans} script(s) could not be read`)
		end
	end

	updateModeButtons()
	updateStats()
	explorer.render(state.results, state.selectedIndex)
	details.render(nil)

	table.insert(connections, refreshButton.Activated:Connect(function()
		if state.scanning then
			state.cancelRequested = true
			setStatus("Cancelling...")
		else
			runScan(state.mode)
		end
	end))
	for _, mode in ipairs(scanModes) do
		table.insert(connections, modeButtons[mode.id].Activated:Connect(function()
			runScan(mode.id)
		end))
	end
	table.insert(connections, exportButton.Activated:Connect(exportResults))
	local rootFrame: Frame = find(widget, "root")
	local function updateCompactText()
		local size = if rootFrame.AbsoluteSize.X < 320 then 11 else 13
		for _, button in pairs(modeButtons) do
			button.TextSize = size
		end
	end
	table.insert(connections, rootFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateCompactText))
	updateCompactText()
	table.insert(connections, rootFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if state.selectedIndex then
			details.render(state.results[state.selectedIndex])
		else
			details.render(nil)
		end
	end))
	details.render(nil)

	table.insert(connections, widget.Destroying:Connect(function()
		explorer.disconnect()
		detailsView.cancel()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		table.clear(connections)
	end))

	return {
		runScan = runScan,
		exportResults = exportResults,
	}
end

return mainUi
]]></ProtectedString>
