					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local counter = {}

-- Split source into lines and strip carriage returns
local function splitLines(source: string): {string}
	local lines: {string} = {}
	local startIndex = 1
	while true do
		local newlineIndex = string.find(source, "\n", startIndex, true)
		local line
		if newlineIndex then
			line = string.sub(source, startIndex, newlineIndex - 1)
		else
			line = string.sub(source, startIndex)
		end
		table.insert(lines, (string.gsub(line, "\r$", "")))
		if not newlineIndex then
			break
		end
		startIndex = newlineIndex + 1
	end
	if source == "" then
		return {}
	end
	if string.sub(source, -1) == "\n" then
		table.remove(lines)
	end
	return lines
end

local function longBracketLevel(line: string, position: number): string?
	return string.match(line, "^%[(=*)%[", position)
end

-- Classify each line as code comment or blank
function counter.countLines(source: string)
	local totalLines, codeLines, commentLines, blankLines = 0, 0, 0, 0
	local mode = "code"
	local level = ""
	for _, line in ipairs(splitLines(source)) do
		totalLines += 1
		-- Plain code lines need no per character scan
		if mode == "code" and not string.find(line, "[%-\"'%[]") then
			if string.find(line, "[^ \t]") then
				codeLines += 1
			else
				blankLines += 1
			end
			continue
		end
		local hasCode = mode == "longString"
		local hasComment = false
		local position = 1
		local length = #line
		while position <= length do
			if mode == "longComment" or mode == "longString" then
				local _, closeEnd = string.find(line, "]" .. level .. "]", position, true)
				if mode == "longComment" then
					hasComment = true
				else
					hasCode = true
				end
				if not closeEnd then
					break
				end
				mode = "code"
				position = closeEnd + 1
			else
				local char = string.sub(line, position, position)
				local nextChar = string.sub(line, position + 1, position + 1)
				if char == " " or char == "\t" then
					position += 1
				-- Line comment with optional long bracket
				elseif char == "-" and nextChar == "-" then
					hasComment = true
					local opener = longBracketLevel(line, position + 2)
					if not opener then
						break
					end
					mode = "longComment"
					level = opener
					position += 4 + #opener
				elseif char == "[" and longBracketLevel(line, position) then
					local opener = longBracketLevel(line, position) :: string
					hasCode = true
					mode = "longString"
					level = opener
					position += 2 + #opener
				elseif char == '"' or char == "'" then
					hasCode = true
					local scan = position + 1
					while scan <= length do
						local c = string.sub(line, scan, scan)
						if c == "\\" then
							scan += 2
						elseif c == char then
							break
						else
							scan += 1
						end
					end
					position = scan + 1
				else
					hasCode = true
					position += 1
				end
			end
		end
		if hasCode then
			codeLines += 1
		elseif hasComment or mode == "longComment" then
			commentLines += 1
		else
			blankLines += 1
		end
	end
	return {
		totalLines = totalLines,
		codeLines = codeLines,
		commentLines = commentLines,
		blankLines = blankLines,
	}
end

function counter.summarize(results: {any})
	local summary = {
		totalScanned = #results,
		successfulScans = 0,
		failedScans = 0,
		totalLines = 0,
		codeLines = 0,
		commentLines = 0,
		blankLines = 0,
	}
	for _, result in ipairs(results) do
		if result.error then
			summary.failedScans += 1
		else
			summary.successfulScans += 1
			summary.totalLines += result.totalLines
			summary.codeLines += result.codeLines
			summary.commentLines += result.commentLines
			summary.blankLines += result.blankLines
		end
	end
	return summary
end

return counter
]]></ProtectedString>
