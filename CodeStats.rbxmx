					<ProtectedString name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local formatter = require(script.Parent.Parent.utils.formatter)
local scanner = require(script.Parent.Parent.utils.scanner)

local detailsPanel = {}

local emptyText = "No script selected. Select a script in the explorer to see its statistics."
local fadeInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function detailsPanel.new(panel: GuiObject, detailsEmpty: TextLabel, detailName: TextLabel, detailRows: {[string]: {left: GuiObject, right: TextLabel}})
	local shownTransparency = panel.BackgroundTransparency
	local textShown: {[TextLabel]: number} = {}
	for _, descendant in ipairs(panel:GetDescendants()) do
		if descendant:IsA("TextLabel") then
			textShown[descendant] = descendant.TextTransparency
		end
	end
	local isShown = false
	local panelTween: Tween? = nil
	local textTweens: {Tween} = {}
	local onHidden: (() -> ())? = nil
	panel.Visible = false

	local function cancelTweens()
		if panelTween then
			panelTween:Cancel()
			panelTween = nil
		end
		for _, tween in ipairs(textTweens) do
			tween:Cancel()
		end
		table.clear(textTweens)
	end

	local function show()
		if isShown then
			return
		end
		isShown = true
		onHidden = nil
		cancelTweens()
		panel.Visible = true
		panel.BackgroundTransparency = 1
		for label, shown in pairs(textShown) do
			label.TextTransparency = 1
			local tween = TweenService:Create(label, fadeInfo, { TextTransparency = shown })
			tween:Play()
			table.insert(textTweens, tween)
		end
		panelTween = TweenService:Create(panel, fadeInfo, { BackgroundTransparency = shownTransparency })
		panelTween:Play()
	end

	local function hide(callback: (() -> ())?)
		if not isShown then
			if panel.Visible then
				onHidden = callback
			elseif callback then
				callback()
			end
			return
		end
		isShown = false
		onHidden = callback
		cancelTweens()
		local tween = TweenService:Create(panel, fadeInfo, { BackgroundTransparency = 1 })
		panelTween = tween
		for label in pairs(textShown) do
			local textTween = TweenService:Create(label, fadeInfo, { TextTransparency = 1 })
			textTween:Play()
			table.insert(textTweens, textTween)
		end
		tween.Completed:Connect(function(playbackState)
			if playbackState ~= Enum.PlaybackState.Completed then
				return
			end
			panel.Visible = false
			local done = onHidden
			onHidden = nil
			if done then
				done()
			end
		end)
		tween:Play()
	end

	local function render(result: scanner.ScriptResult?, onLayout: (() -> ())?)
		if result == nil then
			hide(onLayout)
			return
		end
		local hasResult = result.error == nil
		detailsEmpty.Text = if hasResult then emptyText else "Could not read this script: " .. tostring(result.error)
		detailsEmpty.Visible = not hasResult
		detailName.Visible = hasResult
		for _, pair in pairs(detailRows) do
			pair.left.Visible = hasResult
			pair.right.Visible = hasResult
		end
		if hasResult then
			local total = result.totalLines
			detailName.Text = `{result.name}  ({result.className})`
			detailRows.total.right.Text = formatter.number(total)
			detailRows.code.right.Text = `{formatter.number(result.codeLines)}  ({formatter.percent(result.codeLines, total)})`
			detailRows.comment.right.Text = `{formatter.number(result.commentLines)}  ({formatter.percent(result.commentLines, total)})`
			detailRows.blank.right.Text = `{formatter.number(result.blankLines)}  ({formatter.percent(result.blankLines, total)})`
		end
		show()
		if onLayout then
			onLayout()
		end
	end

	return { render = render, cancel = cancelTweens }
end

return detailsPanel
]]></ProtectedString>
					<string name="ScriptGuid">{36CEBB28-F570-467C-A2AA-534DD66F82D7}</string>
