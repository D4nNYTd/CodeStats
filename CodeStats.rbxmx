				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local counter = require(script.Parent.counter)

local scanner = {}

export type ScriptResult = {
	name: string,
	className: string,
	path: string,
	totalLines: number,
	codeLines: number,
	commentLines: number,
	blankLines: number,
	error: string?,
}

local supportedClasses = {
	Script = true,
	LocalScript = true,
	ModuleScript = true,
}

function scanner.isSupported(instance: Instance): boolean
	return supportedClasses[instance.ClassName] == true
end

-- Collect supported scripts from the roots without duplicates
function scanner.collect(roots: {Instance}): {Instance}
	local found: {Instance} = {}
	local seen: {[Instance]: boolean} = {}
	local function add(instance: Instance)
		if supportedClasses[instance.ClassName] and not seen[instance] then
			seen[instance] = true
			table.insert(found, instance)
		end
	end
	for _, root in ipairs(roots) do
		add(root)
		if not supportedClasses[root.ClassName] then
			for _, descendant in ipairs(root:GetDescendants()) do
				add(descendant)
			end
		end
	end
	return found
end

-- Read source and count lines for one script
local function scanOne(instance: Instance): ScriptResult
	local result: ScriptResult = {
		name = instance.Name,
		className = instance.ClassName,
		path = "",
		totalLines = 0,
		codeLines = 0,
		commentLines = 0,
		blankLines = 0,
	}
	result.path = instance:GetFullName()
	local ok, sourceOrError = pcall(function(): string
		if not instance.Parent then
			error("Script was removed during scan", 0)
		end
		return (instance :: any).Source
	end)
	if not ok then
		result.error = tostring(sourceOrError)
		return result
	end
	local stats = counter.countLines(sourceOrError)
	result.totalLines = stats.totalLines
	result.codeLines = stats.codeLines
	result.commentLines = stats.commentLines
	result.blankLines = stats.blankLines
	return result
end

function scanner.scanScripts(
	scripts: {Instance},
	onProgress: (number, number) -> (),
	isCancelled: () -> boolean
): ({ScriptResult}, boolean)
	local results: {ScriptResult} = {}
	local total = #scripts
	for index, instance in ipairs(scripts) do
		if isCancelled() then
			return results, true
		end
		table.insert(results, scanOne(instance))
		onProgress(index, total)
		-- Yield periodically to keep Studio responsive
		if index % 10 == 0 then
			task.wait()
		end
	end
	return results, false
end

return scanner
]]></ProtectedString>
