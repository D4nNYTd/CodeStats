					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local formatter = {}

function formatter.number(value: number): string
	local digits = tostring(math.floor(value + 0.5))
	local grouped = string.gsub(string.reverse(digits), "(%d%d%d)", "%1,")
	return (string.gsub(string.reverse(grouped), "^,", ""))
end

function formatter.percent(part: number, total: number): string
	if total == 0 then
		return "0.0%"
	end
	return string.format("%.1f%%", part / total * 100)
end

return formatter
]]></ProtectedString>
