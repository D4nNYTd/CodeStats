				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local scanner = require(script.Parent.scanner)

local Selection = game:GetService("Selection")
local selectionManager = {}

function selectionManager.resolve(mode: string): ({Instance}, string?)
	if mode == "entireGame" then
		return scanner.collect({ game }), nil
	end
	local roots: {Instance} = {}
	for _, instance in ipairs(Selection:Get()) do
		local isFolder = mode == "selectedFolder" and instance:IsA("Folder")
		if isFolder or scanner.isSupported(instance) then
			table.insert(roots, instance)
		end
	end
	if #roots == 0 then
		if mode == "selectedFolder" then
			return {}, "Select a Folder or scripts first."
		end
		return {}, "Select Script, LocalScript or ModuleScript objects first."
	end
	return scanner.collect(roots), nil
end

return selectionManager
